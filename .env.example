# BotFather bergan token. Tokenni chatga yoki GitHub'ga joylamang.
BOT_TOKEN=

# polling: kompyuter/VPS; webhook: ommaviy HTTPS manzilli hosting
BOT_MODE=polling
PORT=8080
WEBHOOK_URL=
# Webhook uchun kamida 24 ta tasodifiy harf/raqam. Token bilan bir xil bo'lmasin.
WEBHOOK_SECRET=

# Bo'sh bo'lsa barcha foydalanuvchilarga ochiq. Sinashda o'z Telegram ID'ingizni yozing.
ALLOWED_USER_IDS=

# Oddiy Telegram Bot API: kirish 20 MB, chiqish 49 MB.
MAX_INPUT_MB=20
MAX_OUTPUT_MB=49
MAX_VIDEO_SECONDS=600
JOB_TIMEOUT_SECONDS=1200
MAX_QUEUE_SIZE=5
MAX_IMAGES=10
MAX_IMAGE_PIXELS=25000000
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=200
FFMPEG_THREADS=1

# PATH ichida bo'lsa bo'sh qoldiring.
FFMPEG_PATH=
FFPROBE_PATH=
TESSERACT_PATH=
TESSDATA_PREFIX=
OCR_LANGUAGES=uzb+uzb_cyrl+rus+eng

# Faqat o'zingiz boshqaradigan Telegram Bot API serveri uchun.
# Misol: http://127.0.0.1:8081 (tokenni manzilga qo'shmang).
TELEGRAM_API_URL=
# 20 MB dan katta fayllar uchun: https://my.telegram.org/apps
# Bu BotFather tokenidan alohida Telegram API kalitlari.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL_MODE=false
TELEGRAM_API_DIR=/tmp/telegram-bot-api
